{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hfsaa-public-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "11001",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  "vars": {
    "SUPABASE_URL": "https://pmolfcjxryccsisyhhwm.supabase.co",
    "ENVIRONMENT": "production"
  },
  "env": {
    "staging": {
      "name": "hfsaa-public-api-staging",
      "ratelimits": [
        {
          "name": "API_RATE_LIMITER",
          "namespace_id": "11002",
          "simple": { "limit": 120, "period": 60 }
        }
      ],
      "vars": {
        "SUPABASE_URL": "https://pmolfcjxryccsisyhhwm.supabase.co",
        "ENVIRONMENT": "staging"
      }
    }
  }
}
