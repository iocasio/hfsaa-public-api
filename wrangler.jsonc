{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hfsaa-public-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "r2_buckets": [
    {
      "binding": "DATASET_BUCKET",
      "bucket_name": "hfsaa-public-api-datasets"
    }
  ],
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "11001",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "triggers": {
    "crons": ["0 6 * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  "vars": {
    "SUPABASE_URL": "https://pmolfcjxryccsisyhhwm.supabase.co",
    "ENVIRONMENT": "production",
    "PUBLIC_API_BASE_URL": "https://api.hfsaa.org"
  },
  "env": {
    "staging": {
      "name": "hfsaa-public-api-staging",
      "r2_buckets": [
        {
          "binding": "DATASET_BUCKET",
          "bucket_name": "hfsaa-public-api-datasets-staging"
        }
      ],
      "ratelimits": [
        {
          "name": "API_RATE_LIMITER",
          "namespace_id": "11002",
          "simple": { "limit": 10, "period": 60 }
        }
      ],
      "triggers": {
        "crons": ["0 6 * * *"]
      },
      "vars": {
        "SUPABASE_URL": "https://pmolfcjxryccsisyhhwm.supabase.co",
        "ENVIRONMENT": "staging",
        "PUBLIC_API_BASE_URL": "https://hfsaa-public-api-staging.idris-ocasio.workers.dev"
      }
    }
  }
}

